rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTag(t) { return t is string && t.matches('^[A-Z0-9]{6}$'); }
    // # принадлежит именно этому пользователю
    function ownsTag(t, uid) { return isTag(t) && exists(/databases/$(database)/documents/tags/$(t)) && get(/databases/$(database)/documents/tags/$(t)).data.uid == uid; }
    // никнейм: без изменений, первая установка или смена не чаще раза в неделю (nameAt — мс)
    function nickOk(d, o) {
      let nowMs = request.time.toMillis();
      let same = d.get('nameAt', 0) == o.get('nameAt', 0);
      return (d.get('name', '') == o.get('name', '') && same)
        || (o.get('name', '') == '' && same)
        || (d.get('nameAt', 0) is int && d.get('nameAt', 0) > nowMs - 600000 && d.get('nameAt', 0) < nowMs + 600000
            && o.get('nameAt', 0) < nowMs - 604800000);
    }
    function okCommon(d) {
      return d.name is string && d.name.size() <= 24
        && d.bio is string && d.bio.size() <= 160
        && (d.photo == null || (d.photo is string && d.photo.size() <= 60000))
        && d.preset is int && d.color is int
        && d.stats is map;
    }

    // Личный профиль игрока: читать и менять может только сам владелец
    match /users/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && (resource == null || nickOk(request.resource.data, resource.data))
        && request.resource.data.keys().hasOnly(['name', 'bio', 'photo', 'preset', 'color', 'stats', 'days', 'counts', 'tag', 'friends', 'card', 'subj', 'nameAt', 'updatedAt'])
        && okCommon(request.resource.data)
        && (!('days' in request.resource.data) || (request.resource.data.days is list && request.resource.data.days.size() <= 400))
        && (!('counts' in request.resource.data) || (request.resource.data.counts is map && request.resource.data.counts.size() <= 400))
        && (!('friends' in request.resource.data) || (request.resource.data.friends is list && request.resource.data.friends.size() <= 200))
        && (!('card' in request.resource.data) || (request.resource.data.card is int && request.resource.data.card >= 0 && request.resource.data.card <= 16))
        && (!('subj' in request.resource.data) || (request.resource.data.subj is map && request.resource.data.subj.size() <= 10))
        && (!('tag' in request.resource.data) || request.resource.data.tag == null || ownsTag(request.resource.data.tag, uid));
    }

    // Публичная карточка: видят все вошедшие пользователи, меняет только владелец
    match /profiles/{uid} {
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'bio', 'photo', 'preset', 'color', 'stats', 'tag', 'card', 'lastSeen', 'updatedAt'])
        && okCommon(request.resource.data)
        && (!('card' in request.resource.data) || (request.resource.data.card is int && request.resource.data.card >= 0 && request.resource.data.card <= 16))
        && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen is timestamp)
        && ownsTag(request.resource.data.tag, uid);
    }

    // Приглашение в дуэль: id = {кому}_{от кого}; читают и удаляют только участники
    match /invites/{id} {
      allow read, delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromTag', 'code', 'subject', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 24
        && request.resource.data.fromTag is string && request.resource.data.fromTag.size() <= 6
        && request.resource.data.code is string && request.resource.data.code.matches('^[0-9A-Z]{4,8}$')
        && request.resource.data.subject in ['math', 'rus', 'soc', 'bio', 'phys']
        && request.resource.data.createdAt == request.time;
    }

    // # → uid. Создаётся один раз, изменить или удалить нельзя
    match /tags/{tag} {
      allow read: if signedIn();
      allow create: if signedIn() && isTag(tag)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
